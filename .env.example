# Application
DEBUG=true
ENVIRONMENT=development
APP_NAME=tensor-console
APP_VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./tensor_console.db

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tensor-console
KEYCLOAK_CLIENT_ID=tensor-console-backend
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-production

# Azure AD (for bootstrap endpoint)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# LLM Providers
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=

# AWS Bedrock
AWS_DEFAULT_REGION=us-east-1
AWS_ROLE_ARN=

# Frontend
FRONTEND_URL=http://localhost:5173